# Copier ce fichier en `.env` (RACINE du repo) et remplir les valeurs.
# IMPORTANT : web/vite.config.ts a `envDir: '..'` -> Vite lit le .env RACINE,
# PAS web/.env. Sans ce fichier, le build local (APK Capacitor) part sans
# config Supabase -> "supabaseUrl is required" -> ECRAN BLANC au demarrage.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
