# Signature release de l'app chauffeur.
# Copier ce fichier en `keystore.properties` (meme dossier) et remplir les valeurs
# choisies lors de la generation du keystore (voir commande keytool ci-dessous).
# Le vrai keystore.properties et le fichier .jks sont gitignores : NE JAMAIS les
# committer, et SAUVEGARDER le .jks + les mots de passe ailleurs (perte du
# keystore = impossible de mettre a jour l'app sans desinstallation generale).
#
# Generation (une seule fois), depuis mobile/android/ :
#   & "C:/Users/Utilisateur/.gradle/jdks/eclipse_adoptium-21-amd64-windows.2/bin/keytool.exe" `
#     -genkeypair -v -keystore app/taxivanille-release.jks -alias taxivanille `
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Chemin du .jks relatif a mobile/android/ (rootProject).
storeFile=app/taxivanille-release.jks
storePassword=CHANGE_ME
keyAlias=taxivanille
keyPassword=CHANGE_ME
